# Proxy Clerk FAPI calls — strip /api/__clerk so Clerk receives the bare /v1/... path
/api/__clerk/*  https://clerk.awajimaaai.com/:splat  200

# Proxy all other API calls to the Replit API server
/api/*  https://account.awajimaaai.com/api/:splat  200

# SPA fallback — all unmatched paths serve index.html for React Router
/*  /index.html  200
