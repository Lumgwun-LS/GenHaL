# Clerk API proxy → goes through the API server's clerkProxyMiddleware → frontend-api.clerk.dev
# No DNS for clerk.awajimaaai.com needed — the API server handles it all.
/api/__clerk/*  https://api.awajimaaai.com/api/__clerk/:splat  200

# All other API calls → API server
/api/*  https://api.awajimaaai.com/api/:splat  200

# SPA fallback — all unmatched paths serve index.html for React Router
/*  /index.html  200
